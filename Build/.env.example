# Backend base URL. Leave unset in development to use the Vite dev proxy
# (vite.config.ts forwards /api to http://127.0.0.1:8787).
# VITE_API_URL=http://127.0.0.1:8787

# Production fallback when unset:
# VITE_API_URL=https://htmltrack-worker.neeljaiswal23.workers.dev

# Set to "true" to render the UI with generated sample parcels and make no
# network calls.
# VITE_MOCK_API=true

# Optional. Leave unset to use the keyless Esri Canvas basemap (the default).
# Set this to switch the map to CARTO Voyager / Dark Matter. CARTO no longer
# serves map tiles without a key, so this is required for CARTO to work.
# Note: VITE_* values are inlined into the client bundle and are public.
# VITE_CARTO_API_KEY=your_carto_public_api_key_here
